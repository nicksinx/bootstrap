.PHONY: launch validate-launch github-init backlog-init \
        okf-validate okf-validate-strict okf-migrate-check okf-index-check okf-freshness-check okf-visualize okf-adapter-check okf-context-pack okf-handoff okf-dispatch-status okf-attest openwiki-status \
        release-gate test-launch

PROJECT_ID ?= __PROJECT_ID__

launch:
	./scripts/launch_project.sh --name $(PROJECT_ID) --profile default

validate-launch:
	./scripts/validate_launch.sh

test-launch:
	./scripts/validate_launch.sh

okf-validate:
	./scripts/okf-validate

okf-validate-strict:
	./scripts/okf-validate --strict

okf-migrate-check:
	./scripts/okf-migrate --check

okf-index-check:
	./scripts/okf-index --check

okf-freshness-check:
	./scripts/okf-freshness --check

okf-visualize:
	./scripts/okf-visualize --format html --output /tmp/okf-graph.html

okf-adapter-check:
	./scripts/okf-check-adapters

okf-context-pack:
	./scripts/okf-context-pack

okf-handoff:
	@test -n "$(TASK)" || (echo "usage: make okf-handoff TASK=short-task-name"; exit 2)
	./scripts/okf-handoff $(TASK)

okf-dispatch-status:
	./scripts/okf-dispatch status

okf-attest:
	./scripts/okf-attest-experiment run

openwiki-status:
	./scripts/openwiki-sidecar status

github-init:
	./scripts/github_init.sh

backlog-init:
	./scripts/backlog_seed.sh

release-gate:
	./scripts/validate_launch.sh --release-gate
