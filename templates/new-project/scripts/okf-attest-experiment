#!/usr/bin/env python3
"""Generate or verify deterministic receipts for the OKF attestation experiment."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True


DEFAULT_RECEIPT = Path(".okf-runtime/attestations/okf-bundle-receipt.json")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("run", "verify"))
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--receipt", type=Path, default=DEFAULT_RECEIPT)
    args = parser.parse_args()
    root = args.root.expanduser().resolve()
    receipt_path = args.receipt
    if not receipt_path.is_absolute():
        receipt_path = root / receipt_path
    sys.path.insert(0, str(root / "scripts" / "lib"))
    try:
        from okf_attestation import AttestationError, build_receipt, verify_receipt, write_json

        if args.action == "run":
            receipt = build_receipt(root)
            write_json(receipt_path, receipt, root)
        else:
            receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
        verdict = verify_receipt(root, receipt)
    except (AttestationError, OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
        print(f"okf-attest-experiment: {exc}", file=sys.stderr)
        return 2
    print(json.dumps({"receipt": str(receipt_path), **verdict}, indent=2, sort_keys=True))
    return 0 if verdict["verdict"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
